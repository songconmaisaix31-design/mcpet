# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会入库。
# 麦当劳 MCP Token：在 https://open.mcd.cn/mcp 登录后在「控制台」激活获取。
MCD_MCP_TOKEN=YOUR_MCP_TOKEN_HERE

# 可选：覆盖 MCP 接入地址（默认 https://mcp.mcd.cn）
# MCD_MCP_URL=https://mcp.mcd.cn

# 可选：完全离线演练模式。true 时仍真实调用所有查询与算价，
# 但不提交 create-order，不产生真实订单与支付。
# MCD_DRY_RUN=true

# 大模型层：阶跃星辰（OpenAI 兼容）。在 https://platform.stepfun.com 申请。
# 用于让麦麦理解你的问题并决定调哪个麦当劳 MCP 工具。
STEPFUN_API_KEY=YOUR_STEPFUN_API_KEY_HERE
# 可选，默认 step-3.5-flash
# STEPFUN_MODEL=step-3.5-flash

# 可选：吃饭提醒时刻，默认 11:30
# MCPET_LUNCH_TIME=11:30

# ---------------------------------------------------------------------------
# Agent 桥接（项目进度汇报 + 账号余额提醒）
#
# 这两项功能读的是「本机其他 Agent 的日志」，不是麦当劳 MCP。
# 根目录按 环境变量 > 配置文件 > 平台默认候选 解析；候选不存在就跳过，
# 一个数据源都没有时程序照常运行。完整规范见 docs/AGENT_BRIDGE.md。
# ---------------------------------------------------------------------------

# 可选：覆盖单个 provider 的根目录
# MCPET_AGENT_ROOT_CLAUDE=~/.claude/projects
# MCPET_AGENT_ROOT_CODEX=~/.codex/sessions
# MCPET_AGENT_ROOT_GENERIC=~/.mcpet/inbox

# 可选：批量覆盖（id=path，逗号分隔）
# MCPET_AGENT_ROOTS=claude=/a/b,generic=/c/d

# 可选：配置文件位置，默认 ~/.mcpet/config.json
# MCPET_CONFIG_PATH=~/.mcpet/config.json

# 可选：台账与计价覆盖的目录，默认 ~/.mcpet
# MCPET_DATA_DIR=~/.mcpet

# 可选：滚动窗口长度（小时），默认 5（对齐 Claude 的限流主窗口）
# MCPET_USAGE_WINDOW_HOURS=5

# 可选：会话多久没更新算「停了」（分钟），默认 30
# MCPET_PROGRESS_STALE_MINUTES=30

# 可选：是否采样本机进程表识别活跃 Agent，默认关（需要 psutil）
# MCPET_WATCH_PROCESSES=1
